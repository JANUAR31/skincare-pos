{
  "name": "skincare-pos-complete-final",
  "version": "1.0.0",
  "description": "Aplikasi kasir desktop Leona Store",
  "author": "Leona Store",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "desktop:dev": "concurrently \"npm.cmd run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "desktop:prod": "npm.cmd run build && concurrently \"npm.cmd run start\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "dist": "npm.cmd run build && electron-builder",
    "dist:portable": "npm.cmd run build && electron-builder --win portable"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "jose": "^6.1.0",
    "jspdf": "^4.2.1",
    "mariadb": "^3.4.5",
    "next": "16.2.9",
    "pdfkit": "^0.19.1",
    "prisma": "^7.8.0",
    "puppeteer": "^25.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.leonastore.pos",
    "productName": "Leona Store",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "src/**/*",
      "prisma/**/*",
      "package.json",
      "next.config.ts",
      "postcss.config.mjs",
      "tsconfig.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Leona Store"
    }
  }
}